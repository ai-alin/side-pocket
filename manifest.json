{
  "manifest_version": 3,
  "name": "Side Pocket",
  "version": "0.9.0",
  "description": "侧边栏里的随身口袋：在一台电脑上打开、还没处理完的网页，换台电脑接着处理，处理完两边一起关掉。置顶和收藏存在 Chrome 书签里，跟着 Google 账号走。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "storage",
    "tabs",
    "favicon",
    "clipboardWrite",
    "windows",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开或关闭 Side Pocket",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "打开或关闭侧边栏"
    }
  }
}
